# Frontend
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:8080/v1/graphql
NEXT_PUBLIC_GRAPHQL_WS_URL=ws://localhost:8080/v1/graphql
NEXT_PUBLIC_AUTH_URL=http://localhost:4002
NEXT_PUBLIC_AUTH_MODE=local

# Optional LLM (free tier). If empty, llm_call uses a disclosed stub with ~800ms delay.
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Optional Slack incoming webhook for notify steps. If empty, notify logs to function stdout.
SLACK_WEBHOOK_URL=

# Local Hasura / functions (docker-compose defaults)
HASURA_GRAPHQL_ADMIN_SECRET=local-admin-secret
